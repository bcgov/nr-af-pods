            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "quartech_grantproject",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "quartech_paymentapproved_ea"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Get_Project": {
          "runAfter": {},
          "metadata": {
            "operationMetadataId": "514319f5-7475-4eae-b4cd-e1798acd7e95"
