                "parameters": {
                  "entityName": "systemusers",
                  "recordId": "@items('Get_AF.PODSNotification@gov.bc.ca_User_GUID')?['systemuserid']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_NotificationUser": {
              "runAfter": {
                "Get_a_row_by_ID": [
