              "type": "SetVariable",
              "inputs": {
                "name": "NotificationUser",
                "value": "@outputs('Get_a_row_by_ID')?['body/systemuserid']"
              }
            }
          },
          "runAfter": {
            "Check_AF.PODSNotification@gov.bc.ca": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "0b1bb2e3-35c5-4b8a-91d1-4d1016893954"
          },
          "type": "Foreach"
        },
        "URL": {
          "runAfter": {
            "Get_AF.PODSNotification@gov.bc.ca_User_GUID": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "f2ff66cd-7b77-4503-b155-0d521239e43b"
          },
          "type": "Compose",
          "inputs": "@outputs('Get_Project')?['body/@odata.id']"
        },
        "Initialize_Link": {
          "runAfter": {
            "URL": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "54b61b47-8c0a-4bb3-84dc-d128043352cc"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Link",
                "type": "string",
                "value": "https://@{uriHost(outputs('URL'))}/main.aspx?forceUCI=1&pagetype=entityrecord&etn=quartech_grantproject&id=@{outputs('Get_Project')?['body/quartech_grantprojectid']}"
              }
            ]
          }
        },
        "Get_Program": {
          "runAfter": {
            "Initialize_Link": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "7df3860e-2c08-4638-88eb-5ec35c3e3b60"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
