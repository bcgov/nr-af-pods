            "parameters": {
              "entityName": "msgov_programs",
              "recordId": "@triggerOutputs()?['body/_quartech_program_value']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_Program_Staff": {
          "runAfter": {
            "Get_Program": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "a3ceeb2c-dd02-4d15-b1f9-577a52a49e18"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "systemusers",
              "recordId": "@triggerOutputs()?['body/_quartech_programstaff_value']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Condition": {
          "actions": {
            "Create_Email_Message_Record": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "be04bd73-bd7c-4753-a754-74d1db3c2e2e"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "emails",
                  "item/activitypointer_activity_parties": [
                    {
                      "participationtypemask": 1,
                      "partyid@odata.bind": "systemusers(@{variables('NotificationUser')})"
                    },
                    {
                      "participationtypemask": 2,
                      "partyid@odata.bind": "systemusers(@{outputs('Get_Program_Staff')?['body/systemuserid']})"
                    }
                  ],
                  "item/description": "Hello @{outputs('Get_Program_Staff')?['body/fullname']},<br>\n<br>\nThe Project @{outputs('Get_Project')?['body/quartech_name']} with the Project ID @{outputs('Get_Project')?['body/quartech_pt_projectidentifier']} has reached the status of Payment Approved by the EA and requires your attention. The URL of the Project is <a href=\"@{variables('Link')}\">@{outputs('Get_Project')?['body/quartech_pt_projectidentifier']}</a>.<br>\n<br>\nIf you have any questions you can contact our program area inbox by replying to this message.",
                  "item/quartech_program_email_address": "@outputs('Get_Program')?['body/quartech_programemailaddress']",
                  "item/regardingobjectid_quartech_grantproject_email@odata.bind": "quartech_grantprojects(@{outputs('Get_Project')?['body/quartech_grantprojectid']})",
                  "item/subject": "The Payment has been approved by EA for Project @{triggerOutputs()?['body/quartech_name']}",
                  "item/torecipients": "@outputs('Get_Program')?['body/quartech_programemailaddress']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_Email_Record_to_\"Pending_Sent\"": {
              "runAfter": {
                "Create_Email_Message_Record": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "691fe5ef-5a0a-4ce8-966d-ff90d5f8fdd8"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "operationId": "PerformBoundAction",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "emails",
                  "actionName": "Microsoft.Dynamics.CRM.SendEmail",
                  "recordId": "@outputs('Create_Email_Message_Record')?['body/activityid']",
                  "item/IssueSend": true
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Get_Program_Staff": [
              "Succeeded"
            ]
