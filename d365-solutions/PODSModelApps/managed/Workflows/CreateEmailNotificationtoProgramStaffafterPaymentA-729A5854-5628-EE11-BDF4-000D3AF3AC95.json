          "else": {
            "actions": {
              "Terminate": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "25fe138d-5b08-4114-83fd-78b28007d577"
                },
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Cancelled"
                }
              }
            }
          },
          "expression": {
            "equals": [
              "@triggerOutputs()?['body/quartech_paymentapproved_ea']",
              true
            ]
          },
          "metadata": {
            "operationMetadataId": "ae8487f8-1bd7-4dd0-b955-fe9b4e3eb977"
          },
          "type": "If"
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}