                            }
                          },
                          "runAfter": {
                            "Get_Municipality_GUID_based_on_City_the_applicant_provides": [
                              "Succeeded"
                            ]
                          },
                          "metadata": {
                            "operationMetadataId": "b72350c0-4686-4758-afda-f010a35c261b"
                          },
                          "type": "Foreach"
                        }
                      },
                      "runAfter": {},
                      "expression": {
                        "contains": [
                          "@outputs('Get_the_associated_Program')?['body/quartech_programabbreviation']",
                          "VLB"
                        ]
                      },
                      "metadata": {
                        "operationMetadataId": "a2af742e-46a4-4255-aa5a-f9fab2d7ca47"
                      },
                      "type": "If",
                      "description": "Update start date, end date, and location from City applicant provides"
                    }
                  }
                },
                "expression": {
                  "contains": [
                    "@outputs('Get_the_associated_Program')?['body/quartech_programabbreviation']",
                    "ABPP"
