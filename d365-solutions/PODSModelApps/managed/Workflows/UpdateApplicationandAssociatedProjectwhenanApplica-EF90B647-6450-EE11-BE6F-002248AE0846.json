          "runAfter": {
            "Populate_application_information_to_associated_Project": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "47bf38f6-b1b4-4836-8246-e47b34ebd2bc"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "msgov_businessgrantapplications",
              "recordId": "@triggerOutputs()?['body/msgov_businessgrantapplicationid']",
              "item/quartech_FiscalYear@odata.bind": "@if(empty(variables('vFiscalYear')),null,concat('quartech_fiscalyears(',variables('vFiscalYear'),')'))",
              "item/quartech_ProjectLocation@odata.bind": "@if(empty(variables('vProjectLocationMunicipality')),null,concat('quartech_municipals(',variables('vProjectLocationMunicipality'),')'))"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Populate_application_information_to_associated_Project": {
          "runAfter": {
            "If_Program_is_KTTP_using_quartech_activitystartdate": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "f9c516cd-aa52-4ae6-91d7-088d08aa902f"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "UpdateRecord",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "quartech_grantprojects",
              "recordId": "@triggerOutputs()?['body/_quartech_project_value']",
              "item/quartech_estimatedprojectcost": "@triggerOutputs()?['body/quartech_estimatedbudgettotalactivitycost']",
              "item/quartech_enddate": "@if(equals(variables('vEndDateperProgram'),''),null,variables('vEndDateperProgram'))",
              "item/quartech_location": "@variables('vProjectLocation')",
              "item/quartech_ProjectLocation@odata.bind": "@if(empty(variables('vProjectLocationMunicipality')),null,concat('quartech_municipals(',variables('vProjectLocationMunicipality'),')'))",
              "item/quartech_startdate": "@if(equals(variables('vStartDateperProgram'),''),null,variables('vStartDateperProgram'))",
              "item/quartech_requestedfunding": "@triggerOutputs()?['body/quartech_totalfundingrequiredfromtheprogram']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Initialize_vFiscalYear": {
          "runAfter": {
