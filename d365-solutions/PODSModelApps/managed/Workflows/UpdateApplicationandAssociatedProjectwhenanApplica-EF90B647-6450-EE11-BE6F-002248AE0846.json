            "operationMetadataId": "83459ff6-1401-4b23-9923-a820eaf40685"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "vProjectLocationMunicipality",
                "type": "string",
                "value": "@triggerOutputs()?['body/_quartech_projectlocation_value']"
              }
            ]
          }
        },
