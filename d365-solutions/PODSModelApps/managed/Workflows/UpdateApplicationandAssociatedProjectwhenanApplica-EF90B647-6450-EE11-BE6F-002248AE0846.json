                              "$top": 1
                            },
                            "authentication": "@parameters('$authentication')"
                          }
                        },
                        "Apply_to_each": {
                          "foreach": "@outputs('Get_Municipality_GUID_based_on_City_the_applicant_provides')?['body/value']",
                          "actions": {
                            "Set_Municipality_variable_to_Business_City_field_from_application": {
