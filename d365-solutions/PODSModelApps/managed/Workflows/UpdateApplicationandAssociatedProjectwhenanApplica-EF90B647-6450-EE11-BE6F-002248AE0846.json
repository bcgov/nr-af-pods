          }
        },
        "Get_Municipality_\"BC_Wide\"_ID": {
          "runAfter": {
            "Get_the_associated_Program": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "054a6f48-9b44-4f52-8d42-8f25bde95ecc"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps_1",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "quartech_municipals",
              "$filter": "contains(quartech_name, 'BC Wide')",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "For_KTTP_Program_and_Event_Type_is_Virtual": {
          "actions": {
            "Set_Municipal_to_\"BC_Wide\"": {
              "foreach": "@outputs('Get_Municipality_\"BC_Wide\"_ID')?['body/value']",
              "actions": {
                "Set_vProjectLocationMunicipality_to_BC_Wide": {
                  "runAfter": {},
                  "metadata": {
                    "operationMetadataId": "b792e538-586f-4859-a5be-a8115ada60e3"
                  },
                  "type": "SetVariable",
                  "inputs": {
                    "name": "vProjectLocationMunicipality",
                    "value": "@items('Set_Municipal_to_\"BC_Wide\"')?['quartech_municipalid']"
                  }
                }
              },
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "39d6717d-258f-40e5-9cb3-ca93cf2785bf"
              },
              "type": "Foreach"
            }
          },
          "runAfter": {
            "Initialize_vProjectLocationMunicipality": [
              "Succeeded"
            ]
          },
          "expression": {
            "and": [
              {
                "equals": [
                  "@triggerOutputs()?['body/quartech_eventtype']",
                  255550000
                ]
              },
              {
                "contains": [
                  "@outputs('Get_the_associated_Program')?['body/quartech_programabbreviation']",
                  "KTTP"
                ]
              }
            ]
          },
          "metadata": {
            "operationMetadataId": "3a4eca27-39fe-42ef-84ab-63785dcbcdf5"
          },
          "type": "If"
        },
        "Initialize_vEndDateperProgram": {
          "runAfter": {
            "Initialize_vStartDateperProgram": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "ce194965-2b46-4ddb-a4e5-ea31314b623a"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "vEndDateperProgram",
                "type": "string",
                "value": "@{null}"
              }
            ]
          }
        }
      }
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
