            "authentication": "@parameters('$authentication')"
          }
        },
        "Payment_sent": {
          "actions": {
            "Create_Email_Message_Record": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "a273eaf8-153b-4e1a-ba18-e428b6a30a0d"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps_1",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "emails",
                  "item/activitypointer_activity_parties": [
                    {
                      "participationtypemask": 1,
                      "partyid@odata.bind": "systemusers(@{variables('NotificationUser')})"
                    },
                    {
                      "participationtypemask": 2,
                      "partyid@odata.bind": "systemusers(@{outputs('Get_Expense_Authority')?['body/systemuserid']})"
                    }
                  ],
                  "item/description": "Hello @{outputs('Get_Expense_Authority')?['body/fullname']}, you're listed as the Expense Authority of the @{outputs('Get_Program')?['body/msgov_programname']}.<br>\n<br>\nThe Project @{outputs('Get_Project')?['body/quartech_name']} with the Project ID @{outputs('Get_Project')?['body/quartech_pt_projectidentifier']} has reached the status of Payment Sent to CSNR, and requires your attention. The URL of the Project is <a href=\"@{variables('Link')}\">@{outputs('Get_Project')?['body/quartech_pt_projectidentifier']}</a>.<br>\n<br>\nThis is an automated email. If you have any questions you can contact our program area inbox by replying to this message.",
                  "item/quartech_program_email_address": "@outputs('Get_Program')?['body/quartech_programemailaddress']",
                  "item/regardingobjectid_quartech_grantproject_email@odata.bind": "quartech_grantprojects(@{outputs('Get_Project')?['body/quartech_grantprojectid']})",
                  "item/subject": "The Project @{outputs('Get_Project')?['body/quartech_name']} has reached the status of Payment Sent to CSNR and requires your attention.",
                  "item/torecipients": "@outputs('Get_Expense_Authority')?['body/internalemailaddress']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_Email_Record_to_\"Pending_Sent\"": {
              "runAfter": {
