          "expression": {
            "equals": [
              "@triggerOutputs()?['body/quartech_paymentinprogress']",
              true
            ]
          },
          "metadata": {
            "operationMetadataId": "9d21ff18-01a4-4256-8d1c-e0b72d83eb53"
          },
          "type": "If"
        }
      }
    },
    "templateName": ""
