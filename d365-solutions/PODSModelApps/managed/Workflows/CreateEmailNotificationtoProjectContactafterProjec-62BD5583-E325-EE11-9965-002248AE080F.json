          "metadata": {
            "operationMetadataId": "1aa72cd0-bda3-4ecc-8f3d-39c0d30f3f24"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "msgov_programs",
              "recordId": "@outputs('Get_Project')?['body/_quartech_program_value']"
