            "operationMetadataId": "70740204-88b5-41c4-bb2b-05f92f0ec4e8"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "NotificationUser",
                "type": "string"
              }
            ]
          }
        },
        "Check_AF.PODSNotification@gov.bc.ca": {
          "runAfter": {
            "Initialize_AF.PODS_Notification_User": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "ec3f97f5-f5b9-4052-82c1-2948d89171a0"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "ListRecords",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "systemusers",
              "$filter": "domainname eq 'AF.PODSNotification@gov.bc.ca'",
              "$top": 1
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Get_AF.PODSNotification@gov.bc.ca_User_GUID": {
          "foreach": "@outputs('Check_AF.PODSNotification@gov.bc.ca')?['body/value']",
          "actions": {
            "Get_a_row_by_ID": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "917f4851-141a-44bf-ae98-e39c251183dd"
