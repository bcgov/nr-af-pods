              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "GetItem",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "systemusers",
                  "recordId": "@items('Get_AF.PODSNotification@gov.bc.ca_User_GUID')?['systemuserid']"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_variable": {
              "runAfter": {
                "Get_a_row_by_ID": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "57287ab1-a423-4763-8460-b0a0797fa229"
              },
              "type": "SetVariable",
              "inputs": {
                "name": "NotificationUser",
                "value": "@outputs('Get_a_row_by_ID')?['body/systemuserid']"
              }
            }
          },
          "runAfter": {
            "Check_AF.PODSNotification@gov.bc.ca": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "c32caa2d-e519-41b7-ad2d-e704c1023042"
          },
          "type": "Foreach"
        },
        "Initialize_Status": {
          "runAfter": {
            "Get_AF.PODSNotification@gov.bc.ca_User_GUID": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "ae47b5b5-5c62-4b3b-a8c5-4059a888ff2f"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "StatusText",
                "type": "string",
                "value": "@{outputs('Get_Project')?['body/quartech_projectstatus@OData.Community.Display.V1.FormattedValue']}"
              }
            ]
          }
        },
        "URL": {
          "runAfter": {
            "Initialize_Status": [
