          },
          "metadata": {
            "operationMetadataId": "ee6cab8c-0103-416c-922f-af77543bf35f"
          },
          "type": "Compose",
          "inputs": "@outputs('Get_Project')?['body/@odata.id']"
        },
        "Initialize_Link": {
          "runAfter": {
            "URL": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "30dffce0-f78e-4019-a2ef-691867cbd56e"
          },
          "type": "InitializeVariable",
          "inputs": {
            "variables": [
              {
                "name": "Link",
                "type": "string",
                "value": "https://@{uriHost(outputs('URL'))}/main.aspx?forceUCI=1&pagetype=entityrecord&etn=quartech_grantproject&id=@{outputs('Get_Project')?['body/quartech_grantprojectid']}"
              }
            ]
          }
        },
        "Get_Project_Contact": {
          "runAfter": {
            "Initialize_Link": [
              "Succeeded"
            ]
          },
          "metadata": {
            "operationMetadataId": "4aab6ed5-e691-4193-b053-fa1e2479ef60"
          },
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "contacts",
              "recordId": "@outputs('Get_Project')?['body/_quartech_projectcontact_value']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Project_Status_is_Project_Completed": {
          "actions": {
            "Create_Email_Message_Record": {
              "runAfter": {},
              "metadata": {
                "operationMetadataId": "fdbc32a6-14f2-4c52-b734-186be785f1c4"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "CreateRecord",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "emails",
                  "item/activitypointer_activity_parties": [
                    {
                      "participationtypemask": 1,
                      "partyid@odata.bind": "systemusers(@{variables('NotificationUser')})"
                    },
                    {
                      "participationtypemask": 2,
                      "partyid@odata.bind": "contacts(@{outputs('Get_Project')?['body/_quartech_projectcontact_value']})"
                    }
                  ],
                  "item/description": "Hello @{outputs('Get_Project_Contact')?['body/fullname']},<br>\n<br>\nYour Funding Project @{outputs('Get_Project')?['body/quartech_name']} with the Project ID @{outputs('Get_Project')?['body/quartech_pt_projectidentifier']} is now completed. <br>\n<br>\nIf you have any questions you can contact our program area inbox by replying to this message.",
                  "item/quartech_program_email_address": "@outputs('Get_Program')?['body/quartech_programemailaddress']",
                  "item/regardingobjectid_quartech_grantproject_email@odata.bind": "quartech_grantprojects(@{outputs('Get_Project')?['body/quartech_grantprojectid']})",
                  "item/subject": "Your funding project @{outputs('Get_Project')?['body/quartech_name']} is now completed."
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Set_Email_Record_to_\"Pending_Sent\"": {
              "runAfter": {
                "Create_Email_Message_Record": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "b369cc4d-5016-4fd5-a83f-6712ee76a514"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "PerformBoundAction",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "emails",
                  "actionName": "Microsoft.Dynamics.CRM.SendEmail",
                  "recordId": "@outputs('Create_Email_Message_Record')?['body/activityid']",
                  "item/IssueSend": true
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Get_Program": [
              "Succeeded"
            ]
          },
          "else": {
            "actions": {
              "Terminate": {
                "runAfter": {},
                "metadata": {
                  "operationMetadataId": "05595a0c-42db-46aa-89e5-8546906ea855"
                },
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Cancelled"
                }
              }
            }
          },
          "expression": {
            "equals": [
              "@triggerOutputs()?['body/quartech_projectstatus']",
              255550006
            ]
          },
          "metadata": {
            "operationMetadataId": "dbb12eb7-4147-4203-872c-c6f40eb43fbd"
          },
          "type": "If"
        },
        "Get_Program": {
          "runAfter": {
