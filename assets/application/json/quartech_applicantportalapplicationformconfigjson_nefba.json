{
  "tags": ["Application", "StaffPortal", "NEFBA", "NEFBA Phase 1"],
  "version": "1.1.1",
  "name": "New Entrant Farm Business Accelerator",
  "abbreviation": "NEFBA",
  "hiddenSteps": [{ "name": "tab_Deliverables_Budget" }],
  "sections": [
    {
      "name": "ApplicantInfoStep",
      "additionalTextAboveSection": "<p>Your personal information is collected under section 26(c) and 26(e) of the Freedom of Information and Protection of Privacy Act for the purposes of evaluating applications and for the planning and evaluating of the S-CAP Ministry Program. The information you provide will be shared with the federal government to fulfill the provincial obligations under the Sustainable Canadian Agricultural Partnership (S-CAP) bilateral agreement. It may be combined with other survey or administrative data sources and used for statistical, research and evaluation purposes.</p>",
      "dataName": "tab_ApplicantInfo",
      "fields": [
        {
          "name": "quartech_indigenousapplicant",
          "required": true,
          "elementType": "DropdownSelect"
        },
        {
          "name": "quartech_ownorleaseland",
          "required": true
        },
        {
          "name": "quartech_landsizeusedforoperation",
          "required": true
        },
        {
          "name": "quartech_fillingfarmingincomeontaxreturn",
          "required": true,
          "elementType": "DropdownSelect"
        },
        {
          "name": "quartech_firstyearclaimedfarmingincome",
          "visibleIf": {
            "fieldName": "quartech_fillingfarmingincomeontaxreturn",
            "selectedValue": 255550001
          },
          "validation": {
            "type": "numeric",
            "value": "1900",
            "comparison": "greaterThan"
          }
        },
        {
          "name": "quartech_firstyearfarmoperationgeneratingrevenue",
          "visibleIf": {
            "fieldName": "quartech_fillingfarmingincomeontaxreturn",
            "selectedValue": 255550000
          },
          "validation": {
            "type": "numeric",
            "value": "1900",
            "comparison": "greaterThan"
          }
        },
        {
          "name": "quartech_numberoffulltimeemployees",
          "required": true,
          "validation": {
            "type": "numeric",
            "value": "0",
            "comparison": "greaterThanOrEqualTo"
          }
        },
        {
          "name": "quartech_numberofparttimeemployees",
          "required": true,
          "validation": {
            "type": "numeric",
            "value": "0",
            "comparison": "greaterThanOrEqualTo"
          }
        },
        {
          "name": "quartech_previousyeargrossincome",
          "required": true,
          "format": "currency",
          "maxDigits": 13,
          "emptyInitialValue": true,
          "validation": {
            "type": "numeric",
            "value": "0",
            "comparison": "greaterThanOrEqualTo"
          }
        },
        {
          "name": "quartech_previousyearnetincome",
          "required": true,
          "format": "currency",
          "maxDigits": 13,
          "emptyInitialValue": true,
          "allowNegatives": true
        },
        {
          "name": "quartech_recipienttype",
          "required": true,
          "elementType": "DropdownSelect",
          "label": "Type of Business / Organization. If your operation does both processing and primary production, please select the one that will primarily benefit from this program."
        },
        {
          "name": "quartech_commodity",
          "required": true
        },
        {
          "name": "quartech_operationdoesprocessingandprimaryproducti",
          "required": true,
          "elementType": "DropdownSelect"
        },
        {
          "name": "quartech_livestockprimarytypeandnumber",
          "required": true
        },
        {
          "name": "Business Overview",
          "type": "SectionTitle",
          "hidden": true
        }
      ]
    },
