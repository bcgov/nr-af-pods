  "sections": [
    {
      "name": "ApplicantInfoStep",
      "additionalTextAboveSection": "<p>Your personal information is collected under section 26(c) and 26(e) of the Freedom of Information and Protection of Privacy Act for the purposes of evaluating applications and for the planning and evaluating of the S-CAP Ministry Program. The information you provide will be shared with the federal government to fulfill the provincial obligations under the Sustainable Canadian Agricultural Partnership (S-CAP) bilateral agreement. It may be combined with other survey or administrative data sources and used for statistical, research and evaluation purposes.</p>",
      "displayName": "Eligibility",
      "dataName": "tab_ApplicantInfo",
      "fields": [
        {
          "name": "quartech_areyouanexistingtreefruit",
          "label": "Are you an existing tree fruit (apple, cherry, pear, and/or other stone fruit) producer in B.C., farming over one acre of tree fruits, whose primary purpose is the production and sale of tree fruit products?",
          "required": true,
          "dataFormat": "boolean",
          "onChangeHandler": "checkAndSetTFCREligbilityNotice"
        },
        {
          "name": "quartech_areyouanownerorlesseeoftheland",
          "label": "Are you an owner or lessee of the land the project will take place on?",
          "required": true,
          "dataFormat": "boolean",
          "onChangeHandler": "checkAndSetTFCREligbilityNotice"
        },
        {
          "name": "quartech_areyouataxableentity",
          "label": "Are you a taxable entity (e.g., individual, corporation or trust), limited partnership, commune, cooperative with a GST and business number, or First Nation Band?",
          "required": true,
          "dataFormat": "boolean",
          "onChangeHandler": "checkAndSetTFCREligbilityNotice"
        },
        {
          "name": "quartech_doyoufilefarmincometaxundertaxactinbc",
          "label": "Is your main farmstead in B.C. and do you file farm income tax (form T2042 or T1273) under the Income Tax Act in B.C.? This eligibility requirement may not be applicable to Indigenous applicants.",
          "required": true,
          "dataFormat": "boolean",
          "onChangeHandler": "checkAndSetTFCREligbilityNotice"
        },
        {
          "name": "quartech_doyoucommittomaintainingtheproperty",
          "label": "Do you commit to maintaining the property as a commercial operation for at least four years after completion of the project?",
          "required": true,
          "dataFormat": "boolean",
          "additionalTextBelowField": "<p id='doesNotMeetTFCREligibilityRequirements' style='color:red;display:none;'>Thank you for your interest. As you do not meet all eligibility requirements, your application does not qualify for approval at this time.</p>",
          "onChangeHandler": "checkAndSetTFCREligbilityNotice"
        },
        {
          "name": "quartech_indigenousapplicant",
          "label": "Are you an Indigenous Applicant?",
          "required": true,
          "dataFormat": "boolean",
          "elementType": "DropdownSelect"
        },
        {
          "name": "quartech_ownandorleaseland",
          "label": "Do you own or lease the land that your operation is based on?",
          "required": true
        },
        {
          "name": "quartech_howmanyyearsistheleasevalidfor",
          "label": "How many years is the lease valid for?",
          "required": true,
          "visibleIf": {
            "fieldName": "quartech_ownandorleaseland",
            "selectedValueIn": [255550001],
            "techComment": "I lease the land Selected"
          }
        },
        {
          "name": "quartech_recipienttype",
          "label": "Type of Business / Organization. If your operation does both processing and primary production, please select the one that will primarily benefit from this program.",
          "required": true,
          "initialValue": 255550001,
          "techComment": "intialValue set to Primary Producer",
          "elementType": "DropdownSelect",
          "hidden": true,
          "doNotBlank": true,
          "forceSave": true
        },
        {
          "name": "quartech_commodity",
          "label": "What is your primary production?",
          "required": "true",
          "elementType": "MultiSelectPicklist",
          "initialValue": "732bef41-b75b-ee11-8df0-000d3af3ac95",
          "hidden": true,
          "doNotBlank": true,
          "forceSave": true
        },
        {
          "name": "quartech_whatistheprimarytreefruit",
          "label": "What is the primary tree fruit that will benefit from this project?",
          "required": true
        },
        {
          "name": "quartech_projectlocation",
          "label": "What is the primary project location?",
          "required": "true"
        },
        {
          "name": "quartech_howmanyparcelsoflandwillthisprojectcover",
          "label": "How many parcels of land will this project cover?",
          "format": "number",
          "required": true,
          "initialValue": "0",
          "validation": {
            "type": "numeric",
            "value": "0",
            "comparison": "greaterThanOrEqualTo"
          }
        },
        {
          "name": "quartech_listallparcelidentifiers",
          "label": "List all Parcel Identifiers (PIDs) that the project will cover separated by a comma",
          "required": true,
          "tooltipText": "How to find your PID, click <a href='https://www2.gov.bc.ca/assets/gov/farming-natural-resources-and-industry/agriculture-and-seafood/food-safety/how_to_find_a_bc_land_titles_parcel_id_using_civic_address.pdf' target='_blank' style='font-size: unset; color:blue; margin-left: 0px;'>here</a>."
        }
      ]
    },
    {
