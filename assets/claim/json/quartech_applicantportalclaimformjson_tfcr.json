{
  "tags": ["Claim", "TFCR"],
  "version": "1.0.7",
  "name": "Tree Fruit Climate Resiliency Program",
  "abbreviation": "TFCR",
  "hiddenSteps": [
    {
      "displayName": "Project Results"
    }
  ],
  "customLogo": "/BCID_H_rgb_pos.png",
  "sections": [
    {
      "name": "ApplicantInfoStep",
      "fields": [
        {
          "name": "quartech_legalbusinessororganizationname",
          "label": "Legal Business or Individual's Name"
        },
        {
          "name": "quartech_businessaddress",
          "label": "Locum's Address"
        },
        {
          "name": "quartech_businessphonenumber",
          "format": "phoneNumber",
          "label": "Tel"
        },
        {
          "name": "quartech_businessemailaddress",
          "format": "email",
          "label": "Email"
        },
        {
          "name": "quartech_applicantinformationconfirmation",
          "label": "I / We confirm the above information is correct",
          "required": true,
          "elementType": "DropdownSelect"
        },
        {
          "name": "quartech_applicantinformationcorrections",
          "label": "Please provide further detail",
          "required": true,
          "maxLength": 10000,
          "visibleIf": {
            "fieldName": "quartech_applicantinformationconfirmation",
            "selectedValue": 255550001,
            "techComment": "No value"
          }
        },
        {
          "name": "quartech_filenumber",
          "label": "File Number (from authorization letter)",
          "readOnly": true
        }
      ]
    },
    {
      "name": "ProjectResultsStep",
      "fields": [
        {
          "name": "quartech_claimingforregistrationmembershipfees",
          "label": "Are you claiming 2024 / 2025 annual registrant / membership fees with CVBC and SBCV or BCVTA?",
          "required": true,
          "elementType": "DropdownSelect"
        },
        {
          "name": "quartech_reasonnotclaimingregistrationmembership",
          "label": "Please explain the reason",
          "required": true,
          "visibleIf": {
            "fieldName": "quartech_claimingforregistrationmembershipfees",
            "selectedValue": 255550001,
            "techComment": "No value"
          }
        }
      ]
    },
    {
      "name": "ClaimInfoStep",
      "fields": [
        {
          "name": "quartech_expensereceipts",
          "label": "Expenses Receipts",
          "disableSingleLine": true
        },
        {
          "name": "quartech_totalsumofreportedexpenses",
          "label": "Total sum of reported expenses ($CAD)",
          "format": "currency",
          "required": true,
          "validation": {
            "type": "numeric",
            "value": "0",
            "comparison": "greaterThan"
          },
          "emptyInitialValue": true,
          "onChangeHandler": "calculateAndPopulateRequestedClaimAmountForTFCR",
          "errorMessage": "Sum of all reported expenses must be greater than 0. Please fill the table shown above."
        },
        {
          "name": "quartech_authorizedclaimedamount",
          "label": "Approved Funding as per Authorization Letter (in total)",
          "readOnly": true,
          "onChangeHandler": "calculateAndPopulateRequestedClaimAmountForTFCR"
        },
        {
          "name": "quartech_totalfees",
          "visible": false,
          "label": "Your requested amount in this claim ($CAD)",
          "tooltipText": "Enter the amount you are requesting reimbursement for in this claim",
          "relocateField": {
            "originFieldName": "quartech_totalfees",
            "destinationFieldName": "quartech_numberofdaysprovidingtelemedicinesupport",
            "relativePosition": "below"
          },
          "readOnly": true,
          "required": true,
          "format": "currency",
          "validation": {
            "type": "numeric",
            "value": "0",
            "comparison": "greaterThan"
          }
        }
      ]
    },
    {
      "name": "DocumentsStep",
      "fields": [
        {
          "name": "quartech_proofofpayment",
          "label": "2024 / 2025 receipt for their annual registrant / membership fees with CVBC and SBCV or BCVTA",
          "required": true,
          "elementType": "FileInput"
        },
        {
          "name": "quartech_photosordocsofpurchase",
          "label": "Photos of completed project",
          "required": true,
          "elementType": "FileInput"
        },
        {
          "name": "quartech_directdepositdetails",
          "label": "Direct Deposit details",
          "required": true,
          "elementType": "FileInput"
        }
      ]
    }
  ]
}
